# 应用配置
APP_NAME=Social Auto Upload
APP_VERSION=1.0.0
APP_ENV=production

# MySQL数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=sau_user
DB_PASSWORD=sau_password
DB_NAME=social_auto_upload

# Docker环境下的MySQL配置（生产环境）
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=sau_user
# DB_PASSWORD=sau_password
# DB_NAME=social_auto_upload

# 文件存储配置
VIDEO_FILE_PATH=/app/videoFile
MEDIA_PATH=/app/media
LOG_PATH=/app/logs

# 服务端口配置
BACKEND_PORT=5409
FRONTEND_PORT=80
NGINX_PORT=443

# 小红书服务配置
XHS_SERVER=http://127.0.0.1:11901

# Chrome浏览器路径（如果需要）
LOCAL_CHROME_PATH=

# 安全配置
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# 日志级别
LOG_LEVEL=INFO

# 文件上传限制
MAX_FILE_SIZE=160MB

# 跨域配置
CORS_ORIGINS=*

# SSL配置（生产环境）
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

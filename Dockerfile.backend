# 使用Python 3.11官方镜像作为基础镜像（使用bookworm版本更稳定）
FROM python:3.11-slim-bookworm

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DOCKER_ENV=true

# 设置国内镜像源
RUN echo "deb https://mirrors.aliyun.com/debian/ bookworm main" > /etc/apt/sources.list && \
    echo "deb-src https://mirrors.aliyun.com/debian/ bookworm main" >> /etc/apt/sources.list && \
    echo "deb https://mirrors.aliyun.com/debian-security/ bookworm-security main" >> /etc/apt/sources.list && \
    echo "deb-src https://mirrors.aliyun.com/debian-security/ bookworm-security main" >> /etc/apt/sources.list && \
    echo "deb https://mirrors.aliyun.com/debian/ bookworm-updates main" >> /etc/apt/sources.list && \
    echo "deb-src https://mirrors.aliyun.com/debian/ bookworm-updates main" >> /etc/apt/sources.list

# 设置pip镜像源为阿里云
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.trusted-host mirrors.aliyun.com

# 安装所有系统依赖（基础依赖 + Playwright依赖）
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    libjpeg-dev \
    libpng-dev \
    wget \
    curl \
    unzip \
    fonts-liberation \
    fonts-dejavu-core \
    fonts-freefont-ttf \
    xvfb \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libdrm2 \
    libxrandr2 \
    libxss1 \
    libgtk-3-0 \
    libgdk-pixbuf2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 安装Playwright浏览器（在系统依赖安装完成后）
RUN playwright install chromium

# 复制requirements.txt并安装Python依赖
COPY requirements.txt .
# 升级pip以确保兼容性
RUN pip install --upgrade pip
# 安装依赖，使用更宽松的版本策略
RUN pip install --no-cache-dir -r requirements.txt



# 复制应用代码（.dockerignore 会自动排除不需要的文件和目录）
COPY . .

# 创建必要的目录，确保数据目录结构存在
RUN mkdir -p /app/data/db /app/data/logs /app/data/accounts /app/data/users /app/videoFile /app/logs

# 设置权限
RUN chmod -R 755 /app

# 暴露端口
EXPOSE 5409

# 启动命令
CMD ["python", "sau_backend.py"]
